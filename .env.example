# Copy this file to .env and fill in the two values from your Supabase
# dashboard: Project settings -> API. Restart `npm run dev` afterwards.
#
# The anon key is safe to expose in the browser — protect the data with Row
# Level Security instead. Never put the service_role key here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
